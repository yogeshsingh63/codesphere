    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "react": "^18.3.1",
    "react-codemirror2": "^7.3.0",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-file-icon": "^1.6.0",
    "react-markdown-editor-lite": "^1.4.2",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "react-scripts": "5.0.1",
    "react-sortable-hoc": "^1.11.0",
